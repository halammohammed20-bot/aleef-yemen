# --- Supabase (قاعدة البيانات + تسجيل الدخول) ---
# احصل عليها من: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://xxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Gemini AI (مستشار أليف الذكي) ---
# احصل عليه مجاناً من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: عنوان الموقع بعد نشره (اختياري، يُستخدم في بعض الروابط الذاتية)
APP_URL="MY_APP_URL"
